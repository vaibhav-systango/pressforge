# Project Settings
PROJECT_NAME="Pressforge API"

# ---------------------------------------------------------------------------
# Public URLs — REQUIRED. Different for local vs deployed environments.
#
# Local:
#   FRONTEND_URL=http://localhost:3000
#   PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
#
# Production (example):
#   FRONTEND_URL=https://app.yourdomain.com
#   PUBLIC_API_BASE_URL=https://api.yourdomain.com/api/v1
#
# OAuth callback URLs are derived as:
#   {PUBLIC_API_BASE_URL}/social/{platform}/callback
# Optional override:
#   SOCIAL_OAUTH_CALLBACK_BASE=https://api.yourdomain.com/api/v1/social
# ---------------------------------------------------------------------------
FRONTEND_URL="http://localhost:3000"
PUBLIC_API_BASE_URL="http://localhost:8000/api/v1"
# SOCIAL_OAUTH_CALLBACK_BASE=

# Database Configuration
# format: postgresql://[user]:[password]@[host]:[port]/[database]
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/pressforge"

# JWT Configuration
JWT_SECRET="your-super-secret-access-token-key-change-in-production"
JWT_REFRESH_SECRET="your-super-secret-refresh-token-key-change-in-production"
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=1
INVITE_TOKEN_SECRET="your-super-secret-invite-token-key-change-in-production"
INVITE_TOKEN_EXPIRE_DAYS=7

# Email / SendGrid Configuration
SENDGRID_API_KEY=""
SENDGRID_FROM="verified-sender@example.com"

# Cloudinary (KYC document storage)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
CLOUDINARY_KYC_FOLDER="pressforge/kyc"

# Social OAuth token encryption
TOKEN_ENCRYPTION_KEY="your-token-encryption-key-change-in-production"

# Meta / Instagram OAuth (requires Meta Developer account)
META_APP_ID=""
META_APP_SECRET=""
META_API_VERSION="v17.0"
META_WEBHOOK_VERIFY_TOKEN=""

# LinkedIn OAuth
LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""

# AI content generation (Gemini)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.5-flash"
GEMINI_FALLBACK_MODEL="gemini-3.1-flash-lite"

# Image generation — primary Qwen-Image endpoint (self-hosted / OpenAI-compatible).
# Leave QWEN_IMAGE_API_URL empty to use Pollinations Flux only.
# Example: QWEN_IMAGE_API_URL="http://qwen-image:8000/v1/images/generations"
QWEN_IMAGE_API_URL=""
QWEN_IMAGE_API_KEY=""
QWEN_IMAGE_MODEL="Qwen-Image"
QWEN_IMAGE_TIMEOUT_SECONDS=120

# Alibaba Cloud Model Studio native Qwen-Image API (preferred over the generic
# endpoint above when configured). API key, workspace ID, and region must match.
ALIBABA_DASHSCOPE_API_KEY=""
ALIBABA_WORKSPACE_ID=""
ALIBABA_REGION="ap-southeast-1"
ALIBABA_QWEN_IMAGE_MODEL="qwen-image-2.0-pro"
