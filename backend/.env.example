# Project Settings
PROJECT_NAME="Pressforge API"
FRONTEND_URL="http://localhost:3000"

# Database Configuration
# format: postgresql://[user]:[password]@[host]:[port]/[database]
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/pressforge"

# JWT Configuration
JWT_SECRET="your-super-secret-access-token-key-change-in-production"
JWT_REFRESH_SECRET="your-super-secret-refresh-token-key-change-in-production"
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=1
INVITE_TOKEN_SECRET="your-super-secret-invite-token-key-change-in-production"
INVITE_TOKEN_EXPIRE_DAYS=7

# Email / SendGrid Configuration
SENDGRID_API_KEY=""
SENDGRID_FROM="verified-sender@example.com"

# Cloudinary (KYC document storage)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
CLOUDINARY_KYC_FOLDER="pressforge/kyc"
